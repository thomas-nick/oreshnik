---
import { getCollection } from 'astro:content';
import { Button, Card } from '@eliancodes/brutal-ui';
import BlogList from '../blog/BlogList.astro';

interface Props {
  count?: number;
}

const { count } = Astro.props;

const posts = await getCollection('blog', ({ data }) => !data.draft).then(
  (items) => items.reverse().slice(0, count ?? 3),
);
---

<section class='mt-10'>
  <Card color='#f4e8c8'>
    <div class='flex flex-wrap justify-between items-start gap-3'>
      <div>
        <p class='sw-kicker'>Latest dispatches</p>
        <h2
          class='russo mt-2 text-2xl md:text-4xl lg:text-5xl'
          style='color: var(--sw-black);'
        >
          Recent <span style='color: var(--sw-red);'>posts</span>
        </h2>
      </div>
      <div class='hidden md:block'>
        <Button href='/blog/'>All posts &rarr;</Button>
      </div>
      <div class='block md:hidden'>
        <Button href='/blog/'>All posts</Button>
      </div>
    </div>
    <div class='mt-6'>
      <BlogList posts={posts} />
    </div>
  </Card>
</section>
