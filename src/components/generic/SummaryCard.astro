---
import { Image, type ImageMetadata } from 'astro:assets';
import { Card } from '@eliancodes/brutal-ui';

interface Props {
  title: string;
  imgSrc?: string | ImageMetadata;
  imgAlt: string;
  description: string;
}

const { title, imgAlt, imgSrc, description } = Astro.props;

function isPublicPath(value: string) {
  return value.startsWith('/') || value.startsWith('http');
}
---

<Card color='#f4e8c8'>
  <h3 class='russo text-xl md:text-2xl' style='color: var(--sw-black);'>
    {title}
  </h3>
  {
    imgSrc && (
      <div
        class='my-4 h-56 rounded-lg border-[3px] overflow-hidden'
        style='border-color: var(--sw-black);'
      >
        {
          typeof imgSrc === 'string' && isPublicPath(imgSrc) ? (
            <img
              src={imgSrc}
              alt={imgAlt}
              width={800}
              height={400}
              class='h-full w-full object-cover'
              loading='lazy'
            />
          ) : (
            <Image
              src={imgSrc as ImageMetadata}
              alt={imgAlt}
              width={800}
              height={400}
              class='h-full w-full object-cover'
            />
          )
        }
      </div>
    )
  }
  <p class='outfit mt-2' style='color: var(--sw-black);'>{description}</p>
  <slot />
</Card>
