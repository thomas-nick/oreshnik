---

<section
  class='flex flex-col gap-6 max-w-3xl mx-auto rounded-lg border-[3px] p-8 md:p-12 card-shadow'
  style='background-color: var(--sw-cream); border-color: var(--sw-black); color: var(--sw-black);'
>
  <p class='sw-kicker' style='color: var(--sw-red);'>Lost transmission</p>
  <p
    class='russo text-7xl md:text-9xl leading-none'
    style='color: var(--sw-red);'
  >
    404
  </p>
  <h2 class='russo text-3xl md:text-5xl' style='color: var(--sw-black);'>
    Signal not found
  </h2>
  <p class='outfit text-lg md:text-2xl' style='color: var(--sw-black);'>
    The page you were tuning into has drifted out of range. Try a stronger
    antenna, or head back to the main broadcast.
  </p>
  <a
    href='/'
    title='Go back home'
    class='russo uppercase tracking-widest text-sm border-2 px-4 py-2 inline-block w-fit'
    style='border-color: var(--sw-black); background-color: var(--sw-red); color: var(--sw-cream);'
  >
    &larr; Return to base
  </a>
</section>
