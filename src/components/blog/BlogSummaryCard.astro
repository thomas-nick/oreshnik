---
import type { CollectionEntry } from 'astro:content';
import { Button, Pill } from '@eliancodes/brutal-ui';
import SummaryCard from '../generic/SummaryCard.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<SummaryCard
  title={post.data.title}
  imgAlt={post.data.title}
  imgSrc={post.data.imgUrl}
  description={post.data.description}
>
  <div class='flex justify-end my-4'>
    <Button href={`/blog/${post.id}/`}>Read post &rarr;</Button>
  </div>

  <div class='hidden sm:inline-block'>
    <p class='russo uppercase tracking-widest text-xs mt-2' style='color: var(--sw-red);'>
      Tags
    </p>
    <div class='flex justify-between items-center mt-2'>
      <ul class='flex flex-wrap gap-3'>
        {
          post.data.tags.map((tag) => (
            <li>
              <a class='sanchez' href={`/blog/tags/${tag.toLowerCase()}/`}>
                <Pill>{tag}</Pill>
              </a>
            </li>
          ))
        }
      </ul>
      {
        post.data.draft && (
          <span
            class='rounded-full border-2 px-3 py-1 text-xs card-shadow russo uppercase tracking-widest'
            style='border-color: var(--sw-black); background-color: var(--sw-coral); color: var(--sw-black);'
          >
            Draft
          </span>
        )
      }
    </div>
  </div>
</SummaryCard>
