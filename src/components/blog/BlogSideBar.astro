---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
---

<aside>
  <nav class='hidden lg:block sticky top-6 pr-8'>
    <p
      class='sw-kicker mb-3'
      style='color: var(--sw-coral);'
    >
      Index
    </p>
    <ul class='border-l-2 pl-4' style='border-color: var(--sw-teal);'>
      {
        headings.map((heading) => (
          <li class='py-1'>
            {[...Array(Math.max(0, heading.depth - 1))].map((_, _i) => (
              <span class='inline-block w-3' />
            ))}
            <a
              class='outfit text-sm transition-colors duration-150'
              style='color: var(--sw-cream);'
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  aside a:hover {
    color: var(--sw-coral) !important;
  }
</style>
