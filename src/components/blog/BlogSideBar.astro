---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
---

<aside class='blog-sidebar lg:col-span-3 hidden lg:flex lg:flex-col sticky top-6 h-[calc(100vh-3rem)] pr-8'>
  <nav class='shrink-0'>
    <p class='sw-kicker mb-3' style='color: var(--sw-coral);'>Index</p>
    <ul class='border-l-2 pl-4' style='border-color: var(--sw-teal);'>
      {
        headings.map((heading) => (
          <li class='py-1'>
            {[...Array(Math.max(0, heading.depth - 1))].map((_, _i) => (
              <span class='inline-block w-3' />
            ))}
            <a
              class='outfit text-sm transition-colors duration-150'
              style='color: var(--sw-cream);'
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class='blog-sidebar__art mt-8 flex-1 min-h-[12rem]' aria-hidden='true'>
    <img
      src='/images/cosmonaut-hero.png'
      alt=''
      width='600'
      height='900'
      loading='lazy'
      decoding='async'
    />
  </div>
</aside>

<style>
  aside a:hover {
    color: var(--sw-coral) !important;
  }
</style>
