---
import type { CollectionEntry } from 'astro:content';
import BlogSummaryCard from './BlogSummaryCard.astro';
import { getDispatchNumber } from '../../lib/dispatch';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const sparse = posts.length <= 2;
---

<ul
  class:list={[
    'grid gap-8',
    sparse ? 'max-w-2xl' : 'md:grid-cols-2 lg:grid-cols-3',
  ]}
>
  {
    posts.map((post) => {
      return (
        <li>
          <BlogSummaryCard
            post={post}
            dispatchNumber={getDispatchNumber(post.id, posts)}
          />
        </li>
      );
    })
  }
</ul>
