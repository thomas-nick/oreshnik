---
/**
 * Sovietwave Sky background layer.
 * Fixed-position, decorative, behind all content (z-index: -1).
 * Pure SVG + CSS — no JS, no images.
 */
---

<div class='sw-bg' aria-hidden='true'>
  <div class='sw-stars'></div>
  <div class='sw-stars-2'></div>

  <svg
    class='sw-art'
    viewBox='0 0 1600 900'
    preserveAspectRatio='xMidYMax slice'
    xmlns='http://www.w3.org/2000/svg'
    role='presentation'
  >
    <defs>
      <linearGradient id='sw-sun' x1='0' y1='0' x2='0' y2='1'>
        <stop offset='0%'   stop-color='#ffd66b' />
        <stop offset='35%'  stop-color='#ff8b3d' />
        <stop offset='70%'  stop-color='#d4202d' />
        <stop offset='100%' stop-color='#5a0e1a' />
      </linearGradient>

      <mask id='sw-sun-stripes' maskUnits='userSpaceOnUse' x='600' y='400' width='400' height='420'>
        <rect x='600' y='400' width='400' height='420' fill='white' />
        <rect x='600' y='580' width='400' height='6'  fill='black' />
        <rect x='600' y='620' width='400' height='8'  fill='black' />
        <rect x='600' y='670' width='400' height='12' fill='black' />
        <rect x='600' y='730' width='400' height='16' fill='black' />
        <rect x='600' y='800' width='400' height='22' fill='black' />
      </mask>

      <radialGradient id='sw-glow' cx='50%' cy='50%' r='50%'>
        <stop offset='0%'   stop-color='#ff8b3d' stop-opacity='0.55' />
        <stop offset='100%' stop-color='#ff8b3d' stop-opacity='0' />
      </radialGradient>

      <symbol id='sw-burst' viewBox='-50 -50 100 100'>
        <g fill='currentColor'>
          <path d='M0,-46 L7,-7 L46,0 L7,7 L0,46 L-7,7 L-46,0 L-7,-7 Z' />
          <path d='M-32,-32 L4,-4 L32,-32 L4,4 L32,32 L-4,4 L-32,32 L-4,-4 Z' opacity='0.65' />
        </g>
      </symbol>
    </defs>

    <!-- soft glow behind sun -->
    <circle cx='800' cy='800' r='540' fill='url(#sw-glow)' />

    <!-- retro sun, low on horizon, with horizontal stripes -->
    <circle
      cx='800'
      cy='820'
      r='320'
      fill='url(#sw-sun)'
      mask='url(#sw-sun-stripes)'
    />

    <!-- distant rocket silhouette, tiny, mid-horizon -->
    <g transform='translate(1180 470) rotate(-22)' opacity='0.9'>
      <!-- body -->
      <path d='M0,-110 Q9,-100 9,-50 L9,30 Q9,50 0,55 Q-9,50 -9,30 L-9,-50 Q-9,-100 0,-110 Z'
            fill='#0e0e0e' stroke='#3fa3a0' stroke-width='1.2' />
      <!-- nosecone highlight -->
      <path d='M0,-110 Q5,-100 5,-78 L-5,-78 Q-5,-100 0,-110 Z' fill='#3fa3a0' />
      <!-- red star -->
      <path d='M0,-30 L2.5,-22 L11,-22 L4,-17 L7,-9 L0,-14 L-7,-9 L-4,-17 L-11,-22 L-2.5,-22 Z'
            fill='#d4202d' />
      <!-- fins -->
      <path d='M-9,30 L-26,55 L-9,52 Z' fill='#0e0e0e' stroke='#3fa3a0' stroke-width='1' />
      <path d='M9,30 L26,55 L9,52 Z'    fill='#0e0e0e' stroke='#3fa3a0' stroke-width='1' />
      <!-- exhaust glow -->
      <ellipse cx='0' cy='65' rx='10' ry='22' fill='#ff8b3d' opacity='0.85' />
      <ellipse cx='0' cy='80' rx='5'  ry='14' fill='#ffd66b' opacity='0.95' />
    </g>

    <!-- decorative 8-point bursts (constellation accents) -->
    <g color='#3fa3a0' opacity='0.9'>
      <use href='#sw-burst' x='220'  y='220' width='34' height='34' />
      <use href='#sw-burst' x='1380' y='160' width='26' height='26' />
    </g>
    <g color='#e8a5a0' opacity='0.85'>
      <use href='#sw-burst' x='130'  y='420' width='18' height='18' />
      <use href='#sw-burst' x='1480' y='380' width='22' height='22' />
    </g>
  </svg>

  <!-- perspective grid floor -->
  <div class='sw-grid'></div>
</div>
