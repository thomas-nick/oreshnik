---
import { getCollection, render } from 'astro:content';
import Layout from '@layouts/BlogPost.astro';
import { getDispatchNumber } from '../../lib/dispatch';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => !data.draft);
  return blogEntries.map((blogpost) => ({
    params: { slug: blogpost.id },
    props: { blogpost },
  }));
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { blogpost } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const dispatchNumber = getDispatchNumber(blogpost.id, allPosts);
const { Content } = await render(blogpost);
const headings = blogpost.rendered?.metadata?.headings as Heading[] | undefined;
---

<Layout
  title={blogpost.data.title}
  description={blogpost.data.description}
  pubDate={blogpost.data.pubDate}
  author={blogpost.data.author}
  headings={headings}
  dispatchNumber={dispatchNumber}
>
  <Content />
</Layout>
