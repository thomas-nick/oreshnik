---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BlogList from '@components/blog/BlogList.astro';
import { Button } from '@eliancodes/brutal-ui';
import Layout from '@layouts/Default.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft).then(
    (collection) => collection.reverse(),
  );

  const tags: string[] = [];
  allPosts.forEach((post) => {
    post.data.tags.forEach((tag) => tags.push(tag.toLowerCase()));
  });

  return Array.from(new Set(tags)).map((tag) => ({
    params: { tag },
    props: {
      tag,
      blogposts: allPosts.filter((post) =>
        post.data.tags.map((t) => t.toLowerCase()).includes(tag),
      ),
    },
  }));
}

interface Props {
  tag: string;
  blogposts: CollectionEntry<'blog'>[];
}

const { tag, blogposts } = Astro.props;
---

<Layout
  title={`Tag: ${tag}`}
  description={`Oreshnik | All posts tagged with ${tag}`}
  pageTitle={`Oreshnik | ${tag}`}
>
  <main class='bg-purple-theme p-6'>
    <header class='mb-8'>
      <p class='sw-kicker'>Filter</p>
      <h1
        class='russo mt-2 text-4xl md:text-6xl'
        style='color: var(--sw-cream);'
      >
        Tagged: <span style='color: var(--sw-red);'>{tag}</span>
      </h1>
    </header>
    <div class='mb-6'>
      <Button href='/blog/'>&larr; Back to dispatches</Button>
    </div>
    <BlogList posts={blogposts} />
  </main>
</Layout>
