---
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import MobileSocials from '@components/home/MobileSocials.astro';
import { Button, Card, Pill } from '@eliancodes/brutal-ui';
import Layout from '@layouts/Default.astro';

const builtWith = [
  { name: 'Astro', url: 'https://astro.build/' },
  { name: 'Brutal theme', url: 'https://brutal.elian.codes/' },
  { name: 'Tailwind CSS', url: 'https://tailwindcss.com/' },
  { name: 'Sveltia CMS', url: 'https://sveltia.com/' },
];
---

<Layout
  title='Home'
  pageTitle='Oreshnik | Home'
  description='Personal blog and portfolio — design, UX, and whatever else is worth writing down.'
>
  <main class='bg-pink-theme p-6'>
    <MobileSocials />
    <section id='about' class='grid md:grid-cols-8 gap-8 mt-4'>
      <h2 class='hidden'>About</h2>
      <div class='col-span-4'>
        <Card>
          <div class='flex flex-col justify-between items-start gap-4'>
            <p class='mt-4 outfit text-2xl md:text-5xl lg:text-7xl'>
              Nick Thomas
            </p>
            <p class='mt-2 outfit text-xl md:text-3xl lg:text-5xl'>
              Design, UX, UI — and the occasional blog post.
            </p>
            <Button target={'_self'} href='/blog/'>
              Read the blog &rarr;
            </Button>
          </div>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
            Built with
          </h2>
          <ul class='flex gap-4 flex-wrap'>
            {
              builtWith.map((item) => (
                <li>
                  <Pill>
                    <a
                      class='sanchez'
                      href={item.url}
                      target='_blank'
                      rel='noopener'
                      title={`Go to ${item.name}`}
                    >
                      {item.name}
                    </a>
                  </Pill>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>
            This site
          </h2>
          <p class='poppins'>
            A personal site on the <a href='https://brutal.elian.codes/'>Brutal</a> Astro
            theme. Posts are edited at <a href='/admin/'>/admin</a> via Sveltia CMS and
            deployed to <a href='https://mahoot.xyz'>mahoot.xyz</a>.
          </p>
        </Card>
      </div>
    </section>
    <RecentBlogPosts />
  </main>
</Layout>
