---
import HeroBurst from '@components/generic/HeroBurst.astro';
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import SocialIconList from '@components/generic/SocialIconList.astro';
import { Button, Card, Pill } from '@eliancodes/brutal-ui';
import Layout from '@layouts/Default.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getDispatchNumber } from '../lib/dispatch';
import { socialLinks } from '../lib/socials';

const builtWith = [
  { name: 'Astro', url: 'https://astro.build/' },
  { name: 'Brutal', url: 'https://brutal.elian.codes/' },
  { name: 'Tailwind', url: 'https://tailwindcss.com/' },
  { name: 'Sveltia', url: 'https://sveltia.com/' },
];

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/data/home/home.md');

const { Content: ManifestContent } = await render(home);
const h = home.data;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPost = [...allPosts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)[0];
const latestDispatch = latestPost
  ? getDispatchNumber(latestPost.id, allPosts)
  : null;
---

<Layout title='Home' pageTitle='Oreshnik | Home' description={h.description}>
  <main class='bg-pink-theme p-6 relative overflow-hidden'>
    <!-- ===== HERO ===== -->
    <section class='relative mt-2 grid md:grid-cols-12 gap-6'>
      <h2 class='hidden'>About</h2>

      <div class='md:col-span-8'>
        <Card color='#f4e8c8'>
          <div class='relative overflow-hidden'>
            <p class='sw-kicker'>{h.transmissionKicker}</p>

            <h1
              class='russo mt-2 text-5xl md:text-7xl lg:text-8xl leading-[0.95]'
              style='color: var(--sw-black);'
            >
              <span style='color: var(--sw-red);'>{h.nameHighlight}</span><br />
              {h.nameLine2}
            </h1>

            <p
              class='outfit mt-4 text-lg md:text-2xl max-w-prose'
              style='color: var(--sw-black);'
            >
              {h.tagline}
            </p>

            <div class='mt-6 flex gap-3 flex-wrap items-center'>
              <Button target='_self' href={h.heroButtonHref}>
                {h.heroButtonLabel}
              </Button>
              <a
                href='#about'
                class='russo uppercase tracking-widest text-sm border-b-2'
                style='color: var(--sw-red); border-color: var(--sw-red);'
              >
                {h.manifestAnchorLabel}
              </a>
            </div>

            <div
              class='absolute -top-6 -right-6 md:-top-2 md:-right-4 pointer-events-none'
              style='color: var(--sw-teal);'
            >
              <HeroBurst size={140} />
            </div>
          </div>
        </Card>
      </div>

      <div class='md:col-span-4'>
        {
          latestPost ? (
            <Card color='#3fa3a0'>
              <div style='color: var(--sw-black);'>
                <p class='sw-kicker'>Latest transmission</p>
                <p class='russo mt-2 text-sm uppercase tracking-widest opacity-80'>
                  Dispatch // {latestDispatch}
                </p>
                <h2 class='russo mt-3 text-2xl md:text-3xl leading-tight'>
                  <a
                    href={`/blog/${latestPost.id}/`}
                    class='no-underline hover:opacity-80 transition-opacity'
                    style='color: var(--sw-black);'
                  >
                    {latestPost.data.title}
                  </a>
                </h2>
                <p class='outfit mt-3 text-sm leading-relaxed'>
                  {latestPost.data.description}
                </p>
                <div class='mt-5'>
                  <Button href={`/blog/${latestPost.id}/`}>
                    Read dispatch &rarr;
                  </Button>
                </div>
              </div>
            </Card>
          ) : (
            <Card color='#3fa3a0'>
              <div style='color: var(--sw-black);'>
                <p class='sw-kicker'>Latest transmission</p>
                <p class='outfit mt-4 text-sm'>
                  Silence on the band. Check back soon, or subscribe via{' '}
                  <a href='/feed.xml'>RSS</a>.
                </p>
              </div>
            </Card>
          )
        }
      </div>
    </section>

    <!-- ===== MANIFEST ===== -->
    <section id='about' class='grid md:grid-cols-8 gap-6 mt-8'>
      <div class='md:col-span-5'>
        <Card color='#f4e8c8'>
          <p class='sw-kicker'>{h.manifestKicker}</p>
          <h2
            class='russo mt-2 text-3xl md:text-5xl lg:text-6xl'
            style='color: var(--sw-black);'
          >
            {h.manifestTitle}
            {
              h.manifestTitleHighlight && (
                <span style='color: var(--sw-red);'>
                  {' '}{h.manifestTitleHighlight}
                </span>
              )
            }
          </h2>
          <div class='manifest-body outfit mt-4' style='color: var(--sw-black);'>
            <ManifestContent />
          </div>
        </Card>
      </div>

      <div class='md:col-span-3'>
        <Card color='#3fa3a0'>
          <p class='sw-kicker' style='color: var(--sw-black);'>Apparatus</p>
          <h2
            class='russo mt-2 text-2xl md:text-4xl'
            style='color: var(--sw-black);'
          >
            Built with
          </h2>
          <ul class='flex gap-3 flex-wrap mt-4'>
            {
              builtWith.map((item) => (
                <li>
                  <Pill>
                    <a
                      class='sanchez'
                      href={item.url}
                      target='_blank'
                      rel='noopener'
                      title={`Go to ${item.name}`}
                    >
                      {item.name}
                    </a>
                  </Pill>
                </li>
              ))
            }
          </ul>
          <div
            class='mt-6 pt-4 border-t border-dashed'
            style='border-color: var(--sw-black);'
          >
            <p class='sw-kicker' style='color: var(--sw-black);'>Receiver</p>
            <SocialIconList links={socialLinks} />
          </div>
        </Card>
      </div>
    </section>

    <RecentBlogPosts />
  </main>
</Layout>

<style is:global>
  .manifest-body :is(p, ul, ol) {
    margin-top: 0.75rem;
  }
  .manifest-body :is(p, ul, ol):first-child {
    margin-top: 0;
  }
  .manifest-body a {
    color: var(--sw-red);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .manifest-body a:hover {
    color: var(--sw-black);
  }
</style>
